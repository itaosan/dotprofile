{
  "alwaysThinkingEnabled": true,
  "cleanupPeriodDays": 60,
  "effortLevel": "high",
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": false,
    "codex@openai-codex": false,
    "duckdb-skills@duckdb-skills": false,
    "frontend-design@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "duckdb-skills": {
      "source": {
        "repo": "duckdb/duckdb-skills",
        "source": "github"
      }
    },
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/block-unsafe-bash.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/gh-setup.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(cargo:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Read(**)",
      "Edit(~/**)",
      "WebFetch(domain:*)",
      "Grep(**)",
      "Glob(**)",
      "LS(**)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~:*)",
      "Bash(sudo rm:*)",
      "Bash(format:*)",
      "Bash(:(){ :|:\u0026 };:*)",
      "Bash(dd if=:*)"
    ]
  },
  "plansDirectory": "./docs/plans",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "python3 ~/.claude/statusline.py",
    "type": "command"
  },
  "teammateMode": "auto"
}
